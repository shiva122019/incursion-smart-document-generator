# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Connection Settings
# You can use DATABASE_URL or the individual DB_* variables below:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartdoc_dev

# Individual Database Parameters (fallback if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartdoc_dev
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# Pool Configuration
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Application-Layer Encryption Key (AES-256-GCM 32-byte hex string)
# Used for encrypting sensitive recipient bank details (account numbers, IFSC, PAN)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
