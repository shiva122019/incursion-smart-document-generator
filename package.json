{
  "name": "incursion-smart-document-generator",
  "version": "1.0.0",
  "description": "Smart Document Generator for automatic generation of official college club documents",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/database/cli.js migrate",
    "migrate:status": "node src/database/cli.js status",
    "seed": "node src/database/cli.js seed",
    "db:test-connection": "node src/database/cli.js test-connection",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "document-generator",
    "postgresql",
    "templates",
    "club-management"
  ],
  "author": "ACM Student Chapter, SVNIT",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pg-mem": "^3.0.4",
    "supertest": "^7.3.1"
  }
}
